# Copia este archivo a .env y completa los valores reales.
# Nunca commitees .env — está en .gitignore.

# Prisma / Supabase Postgres
# DATABASE_URL: conexión pooled (pgbouncer) — usada en runtime.
# DIRECT_URL: conexión directa — requerida por `prisma migrate`.
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# Auth (JWT)
JWT_SECRET="genera un secreto aleatorio largo, ej. openssl rand -hex 48"
JWT_EXPIRES_IN="1d"

# CORS — orígenes permitidos, separados por coma. Sin esta variable, el
# servidor solo acepta los orígenes de desarrollo local por defecto
# (http://localhost:8081, http://localhost:19006).
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"

# Supabase Storage (módulo Composición Corporal — fotos de progreso)
# SUPABASE_URL se deriva del mismo proyecto que DATABASE_URL
# (https://<project-ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard > Project Settings > API > service_role.
# El bucket debe crearse manualmente como privado antes del primer uso.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="progress-photos"

# Puerto HTTP del backend (opcional, por defecto 3000)
PORT=3000
