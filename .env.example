# Copia este archivo a .env y completa los valores reales.
# Nunca commitees .env — está en .gitignore.

# Prisma / Supabase Postgres
# DATABASE_URL: conexión pooled (pgbouncer) — usada en runtime.
# DIRECT_URL: conexión directa — requerida por `prisma migrate`.
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# Auth (JWT)
JWT_SECRET="genera un secreto aleatorio largo, ej. openssl rand -hex 48"
JWT_EXPIRES_IN="1d"

# CORS — orígenes permitidos, separados por coma. Sin esta variable, el
# servidor solo acepta los orígenes de desarrollo local por defecto
# (http://localhost:8081, http://localhost:19006).
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"

# Supabase Storage (módulo Composición Corporal — fotos de progreso)
# SUPABASE_URL se deriva del mismo proyecto que DATABASE_URL
# (https://<project-ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard > Project Settings > API > service_role.
# El bucket debe crearse manualmente como privado antes del primer uso.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="progress-photos"

# Puerto HTTP del backend (opcional, por defecto 3000)
PORT=3000

# Detrás de un proxy (Render/Railway/Fly): número de saltos de proxy de confianza.
# Necesario para que el rate limit (throttler) use la IP real del cliente. Local: déjalo vacío.
# TRUST_PROXY=1

# Coach GymIA · proveedor de LLM. Sin ANTHROPIC_API_KEY (o sin LLM_PROVIDER),
# el Coach responde con la decisión real del motor v0
# (src/coach/coach.service.ts), nunca con una respuesta inventada — ver
# src/coach/llm. Anthropic es el proveedor principal decidido (cierre de
# beta, 2026-09-30). Costo medido en prueba real (2026-09-30, Haiku 4.5):
# ~USD 0.001 por mensaje (~660 tokens entrada / ~64 salida) → ~2.7 MXN
# por usuario activo al mes con 5 mensajes/día. Cada respuesta guarda
# modelo, tokens y costo en Message.providerMeta.
LLM_PROVIDER="anthropic"

# anthropic (LLM_PROVIDER=anthropic) — obtener en console.anthropic.com
ANTHROPIC_API_KEY=""
# Modelo (opcional). Por defecto claude-haiku-4-5 — suficiente para explicar
# una decisión ya calculada (DEC-014), no para razonar. Subir a
# un modelo Sonnet solo si la calidad de las respuestas no basta (cambia el
# costo: revisar src/coach/llm/pricing.ts).
# ANTHROPIC_MODEL="claude-haiku-4-5"
# Timeout por intento en ms (opcional, por defecto 15000). Hay 1 solo
# reintento; si falla, el Coach responde con la decisión del motor.
# ANTHROPIC_TIMEOUT_MS=15000

# Límite de mensajes del chat del Coach por día (hora local del usuario)
# para usuarios gratuitos. Al llegar al límite responde el motor, sin
# llamar al LLM. Por defecto 5.
# COACH_FREE_DAILY_LIMIT=5
# Correos sin límite (equipo interno, testers de la beta), separados por comas.
# COACH_UNLIMITED_EMAILS="tu@correo.com"

# Proveedores alternativos (adapter ya construido, sin SDK instalado
# todavía — instalar solo si se cambia de proveedor principal)
# LLM_PROVIDER="openai" | "azure_openai" | "gemini"

# openai (LLM_PROVIDER=openai)
# OPENAI_API_KEY=""

# azure_openai (LLM_PROVIDER=azure_openai) — los 3 son obligatorios juntos
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT="https://<recurso>.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT=""

# gemini (LLM_PROVIDER=gemini)
# GEMINI_API_KEY=""
